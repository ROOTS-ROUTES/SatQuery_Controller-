# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Logs and runtime state
*.log
*.pid
*.sqlite3
gradio_cached_examples/

# Downloaded model weights and generated model data
models/*
!models/.gitkeep
!models/backbone_adapter
!models/vqa_adapter
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# ...but DO version the fine-tuned LoRA adapters — the irreplaceable
# fine-tuned weights. Big .safetensors files go through Git LFS (see
# .gitattributes); tokenizer/config files stay as plain git.
!models/backbone_adapter/**
!models/vqa_adapter/**

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build artifacts
dist/
build/
*.egg-info/

# Prebuilt offline frontend (built from the SatQuery-AI frontend repo,
served by server.py; rebuild it there rather than committing the bundle)
frontend_dist/